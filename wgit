#!/bin/sh
set -eu
WG_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WG_JAR=${WGIT_JAR:-"$WG_ROOT/cli/build/libs/wgit.jar"}
if [ ! -f "$WG_JAR" ]; then
  printf '%s
' '請先執行 ./gradlew :cli:fatJar（或設定 WGIT_JAR）' >&2
  exit 1
fi
if [ -n "${JAVA_HOME:-}" ]; then exec "$JAVA_HOME/bin/java" -jar "$WG_JAR" "$@"; fi
exec java -jar "$WG_JAR" "$@"
