  "id": "worldgit",
  "version": "${version}",
  "name": "WorldGit",
  "description": "Git-style version control for Minecraft worlds.",
  "license": "MIT",
  "environment": "*",
  "mixins": ["worldgit.mixins.json"],
  "entrypoints": {
    "main": ["org.worldgit.fabric.WorldGitMod"],
